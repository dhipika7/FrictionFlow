# Database settings (Defaults to 'sqlite' for easy local development, or 'mongodb' / 'hybrid')
DATABASE_URL=sqlite:///./frictionflow.db
DATABASE_TYPE=sqlite
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=frictionflow

# AI Provider settings: 'mock', 'gemini', or 'openai'
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Firebase Auth Configuration (Optional for production, fallback auth active in local/demo mode)
FIREBASE_PROJECT_ID=frictionflow-demo
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Backend Security
SECRET_KEY=frictionflow-super-secret-key-2026-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Mode toggle (seeds rich synthetic data for presentations)
DEMO_MODE=true

# Server Config
HOST=0.0.0.0
PORT=8000
